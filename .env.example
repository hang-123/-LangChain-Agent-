# ── LLM ──
QUERY_ENGINE_API_KEY=your_dashscope_or_openai_compatible_key
QUERY_ENGINE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
QUERY_ENGINE_MODEL_NAME=qwen-plus

# ── Search ──
TAVILY_API_KEY=your_tavily_key
MAX_RETRIES=3
TAVILY_MAX_RESULTS=5

# ── Database (PostgreSQL + pgvector required) ──
RAG_DATABASE_URL=postgresql://localhost:5432/bettafish
LTM_DATABASE_URL=

# ── Embedding (BGE-M3 via SiliconFlow) ──
EMBEDDING_PROVIDER=siliconflow
EMBEDDING_API_KEY=your_siliconflow_key
EMBEDDING_MODEL=BAAI/bge-m3
EMBEDDING_DIM=1024

# ── RAG ──
ENABLE_RAG=1
ENABLE_RAG_WRITEBACK=1
RAG_TOP_K=4
RAG_WRITEBACK_QUALITY_THRESHOLD=70
RAG_DENSE_WEIGHT=0.7
RAG_SPARSE_WEIGHT=0.3
RAG_TRUST_BONUS=0.5
ENABLE_RERANKER=0

# ── Memory ──
ENABLE_CONVERSATION_MEMORY=1
ENABLE_LTM=1
STALE_IMPORTANCE=0.2
SOFT_DELETE_IMPORTANCE=0.1
HARD_DELETE_DAYS_AFTER_SOFT=30
REFRESH_MAX_RETRIES=3
REFRESH_FAILED_PENALTY=0.5

# ── Cache ──
ENABLE_CACHE=0
CACHE_DB_PATH=var/cache/langgraph_cache.sqlite
REDIS_URL=redis://localhost:6380/0

# ── Observability ──
ENABLE_NODE_PERF=0
ENABLE_OTEL=0
OTEL_EXPORTER=console
OTEL_ENDPOINT=
OTEL_SERVICE_NAME=bettafish-harness

# ── Security ──
ENABLE_GUARDRAILS=0
GUARDRAILS_MODE=minimal_blocking

# ── Experiment ──
EXPERIMENT_ID=
EXPERIMENT_ROLLOUT_PCT=0
EXPERIMENT_VARIANTS=control,treatment
FORCE_VARIANT=

# ── Query Store ──
ENABLE_QUERY_STORE=0
QUERY_STORE_PATH=logs/harness/query_store.sqlite

# ── Frontend ──
VITE_API_BASE_URL=http://localhost:9000
