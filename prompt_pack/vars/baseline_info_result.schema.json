{
  "type": "object",
  "required": ["baseline_path", "missing_items", "detected_versions"],
  "properties": {
    "baseline_path": {
      "type": "string"
    },
    "missing_items": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["key", "status", "how_to_get"],
        "properties": {
          "key": {
            "type": "string"
          },
          "status": {
            "type": "string",
            "enum": ["未指定", "已检测", "需人工确认"]
          },
          "how_to_get": {
            "type": "string"
          }
        }
      }
    },
    "detected_versions": {
      "type": "object"
    },
    "notes_md_path": {
      "type": "string"
    }
  }
}
