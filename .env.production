# ============================================================
# BettaFish 生产环境变量模板
# ============================================================
# 使用: cp .env.production .env → 编辑填入真实值 → docker compose up -d

# ── LLM (必填) ──
QUERY_ENGINE_API_KEY=sk-your-key-here
QUERY_ENGINE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
QUERY_ENGINE_MODEL_NAME=qwen-plus

# ── Search (必填) ──
TAVILY_API_KEY=tvly-your-key-here
MAX_RETRIES=3
TAVILY_MAX_RESULTS=5

# ── PostgreSQL (docker-compose 用) ──
PG_DB=bettafish
PG_USER=bettafish
PG_PASSWORD=请修改为强密码至少16位

# ── 数据库连接串 (应用用) ──
# 注意: host 用 docker-compose 的服务名 "postgres"
RAG_DATABASE_URL=postgresql://bettafish:请修改为强密码至少16位@postgres:5432/bettafish
LTM_DATABASE_URL=

# ── Embedding (必填) ──
EMBEDDING_PROVIDER=siliconflow
EMBEDDING_API_KEY=sk-your-key-here
EMBEDDING_MODEL=BAAI/bge-m3
EMBEDDING_DIM=1024

# ── Redis ──
# 注意: host 用 docker-compose 的服务名 "redis"
REDIS_URL=redis://redis:6379/0

# ── RAG ──
ENABLE_RAG=1
ENABLE_RAG_WRITEBACK=1
RAG_TOP_K=4
RAG_WRITEBACK_QUALITY_THRESHOLD=70
RAG_DENSE_WEIGHT=0.7
RAG_SPARSE_WEIGHT=0.3
RAG_TRUST_BONUS=0.5
ENABLE_RERANKER=0

# ── Memory ──
ENABLE_CONVERSATION_MEMORY=1
ENABLE_LTM=1
STALE_IMPORTANCE=0.2
SOFT_DELETE_IMPORTANCE=0.1
HARD_DELETE_DAYS_AFTER_SOFT=30
REFRESH_MAX_RETRIES=3
REFRESH_FAILED_PENALTY=0.5

# ── Cache ──
ENABLE_CACHE=0
CACHE_DB_PATH=var/cache/langgraph_cache.sqlite

# ── Observability ──
ENABLE_NODE_PERF=0
ENABLE_OTEL=0
DEPLOYMENT_ENV=production

# ── Security ──
ENABLE_GUARDRAILS=0

# ── App ──
OWNER=your-name
TEAM_SIZE=1
ROLES=builder
MONTHLY_BUDGET=100
COST_PER_RUN_CAP=1.0
